{
  "name": "tddforge",
  "version": "0.1.0",
  "description": "Repo-native AI testing CLI for story-to-test workflows",
  "type": "module",
  "bin": {
    "tddforge": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "keywords": [
    "cli",
    "tdd",
    "testing",
    "ollama",
    "openai",
    "vitest",
    "jest"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "execa": "^9.6.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "openai": "^6.6.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
